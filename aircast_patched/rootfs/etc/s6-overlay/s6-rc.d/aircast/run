#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Community App: AirCast
# Runs the AirCast server
# ==============================================================================
declare -a options

bashio::log.info 'Starting the AirCast server...'

# Non-interactive
options+=(-Z)

# Configuration file
options+=(-x '/config/aircast.xml')

# Update configuration file when new devices where detected
options+=(-I)

# Bind to a specific interface
if bashio::config.has_value 'address'; then
    options+=(-b "$(bashio::config 'address')")
fi

# Find the matching AirCast log level
if bashio::config.exists 'log_level'; then
    case "$(bashio::string.lower "$(bashio::config 'log_level')")" in
        all|trace)
            options+=(-d 'all=sdebug')
            ;;
        debug)
            options+=(-d 'all=debug')
            ;;
        info|notice)
            options+=(-d 'all=info')
            ;;
        warning)
            options+=(-d 'all=warn')
            ;;
        error|fatal|off)
            options+=(-d 'all=error')
            ;;
    esac
fi
# Set latency
options+=(-l "$(bashio::config 'latency_rtp'):$(bashio::config 'latency_http')")

# Audio format sent to the speakers (default flac from aircast.xml)
if bashio::config.has_value 'codec'; then
    options+=(-c "$(bashio::config 'codec')")
fi

# How the HTTP stream is sent to the speakers (experiment for Nest firmware 3.79.561352)
if bashio::config.has_value 'http_mode'; then
    case "$(bashio::config 'http_mode')" in
        chunked) options+=(-H -3) ;;
        length) options+=(-H 2000000000) ;;
    esac
fi

# Force the Cast receiver app (experiment: 46C1A819 instead of the default CC1AD845)
if bashio::config.has_value 'receiver'; then
    options+=(-R "$(bashio::config 'receiver')")
fi

# Drift mode?
if bashio::config.true 'drift'; then
    options+=(-r)
fi

# Run the AirCast server
exec aircast "${options[@]}"
